{
  "name": "@shogroupspace/snapseal-codec",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript encoder and decoder for SnapSeal protected images, files and text, including JPEG recovery and legacy passwords.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.22.0" },
  "repository": { "type": "git", "url": "https://github.com/ShoGroupSpace/snapseal-codec.git" },
  "homepage": "https://snapseal.app",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js" },
    "./browser": { "types": "./dist/types/browser.d.ts", "import": "./dist/browser.js" },
    "./node": { "types": "./dist/types/node.d.ts", "import": "./dist/node.js" }
  },
  "bin": { "snapseal": "./bin/snapseal.mjs" },
  "files": ["dist", "bin", "assets", "licenses", "LICENSE", "THIRD-PARTY-NOTICES.md", "docs"],
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "fixtures:generate": "node scripts/generate-vectors.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "@zxing/library": "0.23.0", "hash-wasm": "4.12.0", "pngjs": "7.0.0" },
  "devDependencies": { "@playwright/test": "1.58.2", "@types/node": "25.9.9", "@types/pngjs": "6.0.5", "esbuild": "0.25.12", "typescript": "5.9.3", "vitest": "4.1.12" },
  "optionalDependencies": { "playwright": "1.58.2" }
}
